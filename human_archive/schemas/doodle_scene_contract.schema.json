{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doodle_scene_contract.schema.json",
  "title": "Doodle Scene Contract",
  "type": "object",
  "required": [
    "scene_id",
    "order",
    "sentence_ids",
    "visual_role",
    "host_mode",
    "historical_subjects",
    "era_context",
    "overlay_text",
    "must_not"
  ],
  "properties": {
    "scene_id": {"type": "string", "minLength": 1},
    "order": {"type": "integer", "minimum": 1},
    "sentence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "visual_role": {
      "enum": [
        "host_explainer",
        "historical_reconstruction",
        "evidence_object",
        "diagram_metaphor",
        "atmosphere"
      ]
    },
    "host_mode": {"enum": ["full", "absent"]},
    "historical_subjects": {"type": "array", "items": {"type": "string"}},
    "era_context": {"type": "string", "minLength": 1},
    "overlay_text": {"type": "array", "items": {"type": "string"}},
    "must_not": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"visual_role": {"const": "host_explainer"}}},
      "then": {"properties": {"host_mode": {"const": "full"}}},
      "else": {"properties": {"host_mode": {"const": "absent"}}}
    }
  ],
  "additionalProperties": true
}
