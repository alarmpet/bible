{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceSnapshotManifest",
  "type": "object",
  "required": ["schema_version", "created_at_utc", "sources"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "created_at_utc": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "url_or_doi", "title", "authors_or_agency", "year", "evidence_spans"],
        "properties": {
          "source_id": { "type": "string" },
          "url_or_doi": { "type": "string" },
          "title": { "type": "string" },
          "authors_or_agency": { "type": "string" },
          "year": { "type": "integer" },
          "evidence_spans": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["span_id", "locator", "summary", "text_excerpt"],
              "properties": {
                "span_id": { "type": "string" },
                "locator": { "type": "string" },
                "summary": { "type": "string" },
                "text_excerpt": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
