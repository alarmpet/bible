{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FactCheckReport",
  "type": "object",
  "required": [
    "schema_version",
    "verified_at_utc",
    "total_sentences",
    "unsupported_count",
    "unresolved_conflict_count",
    "forbidden_wording_count",
    "sentence_evaluations"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "verified_at_utc": { "type": "string" },
    "total_sentences": { "type": "integer" },
    "unsupported_count": { "type": "integer" },
    "unresolved_conflict_count": { "type": "integer" },
    "forbidden_wording_count": { "type": "integer" },
    "sentence_evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sentence_id", "status", "issues"],
        "properties": {
          "sentence_id": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "QUALIFIED"] },
          "issues": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
