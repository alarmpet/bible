{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactApprovalV2",
  "type": "object",
  "required": [
    "schema_version",
    "decision",
    "reviewer_id",
    "approved_at_utc",
    "artifacts",
    "unresolved_issues"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "decision": { "type": "string", "enum": ["approved", "rejected"] },
    "reviewer_id": { "type": "string" },
    "role": { "type": "string" },
    "approved_at_utc": { "type": "string" },
    "artifacts": {
      "type": "object",
      "required": ["script_sha256", "fact_report_sha256", "persona_report_sha256"],
      "properties": {
        "script_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "fact_report_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "persona_report_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "claim_inventory_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "source_snapshot_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "candidate_video_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
      }
    },
    "unresolved_issues": { "type": "integer", "const": 0 },
    "notes": { "type": "string" }
  }
}
