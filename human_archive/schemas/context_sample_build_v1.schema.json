{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextSampleBuildV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_id", "build_id", "delivery_profile", "source_build_id", "source_artifacts", "segments"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "build_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "delivery_profile": {"type": "string", "enum": ["quick_3m", "pilot", "trend_explainer_20m"]},
    "source_build_id": {"type": "string", "minLength": 1},
    "source_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_build_path", "source_script_path", "script_sha256", "claims_sha256", "fact_report_sha256", "fact_approval_sha256", "persona_report_sha256"],
      "properties": {
        "source_build_path": {"type": "string", "minLength": 1},
        "source_script_path": {"type": "string", "minLength": 1},
        "script_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "claims_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "fact_report_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "fact_approval_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "persona_report_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_sentence_id", "source_sentence_ids", "edit_mode", "display_text", "tts_text_sha256", "claim_ids", "evidence_span_ids", "visual"],
        "properties": {
          "sample_sentence_id": {"type": "string", "minLength": 1},
          "source_sentence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "edit_mode": {"type": "string", "enum": ["exact", "rewrite"]},
          "display_text": {"type": "string", "minLength": 1},
          "tts_text_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
          "claim_ids": {"type": "array", "items": {"type": "string"}},
          "evidence_span_ids": {"type": "array", "items": {"type": "string"}},
          "editorial_approval_sha256": {"type": ["string", "null"], "pattern": "^[A-F0-9]{64}$"},
          "source_audio_file": {"type": "string"},
          "source_audio_duration_sec": {"type": "number", "minimum": 0},
          "pause_after_sec": {"type": "number", "minimum": 0},
          "visual": {
            "type": "object",
            "additionalProperties": false,
            "required": ["asset_origin"],
            "properties": {
              "asset_origin": {"type": "string", "enum": ["reuse", "generated", "imported"]},
              "source_asset_path": {"type": "string"},
              "source_asset_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
              "source_request_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
              "approval_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
              "request_id": {"type": "string"},
              "request_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
              "file_path": {"type": "string"},
              "file_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
              "card_id": {"type": "string"},
              "prompt_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
              "source_shot_id": {"type": ["string", "null"]}
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"edit_mode": {"const": "rewrite"}}}, "then": {"required": ["editorial_approval_sha256"]}},
          {"if": {"properties": {"visual": {"properties": {"asset_origin": {"const": "reuse"}}}}}, "then": {"properties": {"visual": {"required": ["source_asset_path", "source_asset_sha256", "source_request_sha256", "approval_sha256"]}}}},
          {"if": {"properties": {"visual": {"properties": {"asset_origin": {"enum": ["generated", "imported"]}}}}}, "then": {"properties": {"visual": {"required": ["file_path", "file_sha256", "request_sha256", "approval_sha256"]}}}}
        ]
      }
    }
  }
}
