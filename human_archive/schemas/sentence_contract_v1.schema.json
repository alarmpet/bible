{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NollamSentenceContractV1",
  "type": "object",
  "required": ["episode_id", "sentences"],
  "properties": {
    "episode_id": {"type": "string", "minLength": 1},
    "target_duration_sec": {"type": "number", "exclusiveMinimum": 0},
    "sentences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sentence_id", "order", "spoken_text", "display_text", "phase", "claim_ids", "fact_grade", "visual_intent"],
        "properties": {
          "sentence_id": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1},
          "spoken_text": {"type": "string", "minLength": 1},
          "display_text": {"type": "string", "minLength": 1},
          "phase": {"enum": ["phase_1_hook", "phase_2_mechanism", "phase_3_crisis", "phase_4_discovery", "phase_5_reflection"]},
          "claim_ids": {"type": "array", "items": {"type": "string"}},
          "fact_grade": {"type": "string", "minLength": 1},
          "visual_intent": {"type": "string", "minLength": 1},
          "beat": {"type": "string"},
          "start_sec": {"type": "number", "minimum": 0},
          "end_sec": {"type": "number", "exclusiveMinimum": 0}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
