{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClaimInventory",
  "type": "object",
  "required": ["schema_version", "created_at_utc", "claims"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "created_at_utc": { "type": "string" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "statement",
          "type",
          "source_ids",
          "locators",
          "entity_scope",
          "time_scope",
          "allowed_wording",
          "forbidden_wording"
        ],
        "properties": {
          "claim_id": { "type": "string" },
          "statement": { "type": "string" },
          "type": { "type": "string" },
          "source_ids": { "type": "array", "items": { "type": "string" } },
          "locators": { "type": "array", "items": { "type": "string" } },
          "entity_scope": { "type": "array", "items": { "type": "string" } },
          "time_scope": { "type": "array", "items": { "type": "string" } },
          "conflict_group_id": { "type": ["string", "null"] },
          "support_level": { "type": "string" },
          "allowed_wording": { "type": "array", "items": { "type": "string" } },
          "forbidden_wording": { "type": "array", "items": { "type": "string" } },
          "risk": { "type": "string" }
        }
      }
    }
  }
}
