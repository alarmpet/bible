{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NativeMessage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "message_id",
    "type",
    "job_id",
    "payload"
  ],
  "properties": {
    "protocol_version": { "type": "integer", "const": 1 },
    "message_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "type": {
      "type": "string"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  }
}
