{
  "manifest_version": 3,
  "key": "",
  "name": "NOLLAM Flow Automation",
  "version": "0.1.0",
  "description": "Fail-closed bulk image generation orchestration for Google Flow.",
  "permissions": ["storage", "downloads", "sidePanel", "nativeMessaging", "scripting", "tabs"],
  "host_permissions": ["https://labs.google/*"],
  "action": {"default_title": "Open NOLLAM Flow Automation"},
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "side_panel": {"default_path": "sidepanel/index.html"},
  "content_scripts": [{"matches": ["https://labs.google/*/tools/flow/project/*"], "js": ["content/content-script.js"]}],
  "web_accessible_resources": [
    {
      "resources": ["content/*"],
      "matches": ["https://labs.google/*"]
    }
  ]
}
