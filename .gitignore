# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Pytest and test caches
.pytest_cache/
pytest-cache-files-*/
_pytest_basetemp/

# Logs
*.log
*.err.log
*.out.log

# Virtual Environments
.venv/
venv/
ENV/
env/

# IDE / Editor
.serena/
.superpowers/sdd/
.worktrees/
.vscode/
.idea/

# Large media files and models (never commit binaries)
*.mp4
*.mp3
*.wav
*.m4a
*.flac
*.ogg
*.pt
*.pth
*.bin
*.safetensors
*.onnx

# Allow essential voice reference samples in repository
!bible_healing/assets/voice_refs/*.wav

# Video assets and generated runtime folders
bible_healing/assets/movie-sample/
bible_healing/assets/generated/
bible_healing/runs/
modern/runs/smoke_g1/

# human_archive: generated build/run outputs and run-scoped audit logs (never commit)
human_archive/runs/
human_archive/audit/
human_archive/audits/
human_archive/.pytest_temp/
human_archive/*.pytest-*/

# human_archive: isolated internal-benchmark-only content — never publish, never commit
# (docs/superpowers/plans/2026-09-15-human-archive-nollam-script-visual-motion-multi-llm-overhaul-plan.md §6)
human_archive/research/human_library_benchmark_internal_only/

# human_archive: runtime databases regenerated from seeds/scripts, not source
human_archive/**/*.sqlite3
human_archive/**/*.sqlite

